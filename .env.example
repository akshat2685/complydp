# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/complydp

# Asynchronous Job Queue (Redis 7+)
REDIS_URL=redis://localhost:6379

# Authentication & Session Security
AUTH_SECRET=generate-a-secure-32-byte-secret-for-production
NEXTAUTH_URL=http://localhost:3000

# Evidence & Artifact Storage (S3-compatible / MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=complydp-evidence-locker
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1

# AI Inference Provider Abstraction (openai | anthropic | local)
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL_CLASSIFICATION=gpt-4o-mini
AI_MODEL_SUMMARY=gpt-4o

# Source Code Discovery (GitHub App / OAuth)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Regulatory Framework Default
DPDP_DEFAULT_FRAMEWORK=DPDP_ACT_2023_RULES_2026
DPBI_REPORTING_WINDOW_HOURS=72
